# ==============================================================================
# DOCENT AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your API credentials before starting.

# 1. LLM API Key (Groq Cloud)
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Vector Database (Pinecone Cloud)
# Obtain your free serverless Pinecone key at: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=pdf-chatbot

# 3. Model & Ingestion Defaults (Optional Overrides)
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
